// Deploys worker.js as the second-atmosphere-gdelt Worker.
// Used by Cloudflare Workers Builds when the Worker is connected to this
// repo (root directory: worker), so a push to main deploys it.
{
  "name": "second-atmosphere-gdelt",
  "main": "worker.js",
  "compatibility_date": "2026-06-27",
  "workers_dev": true,
  "observability": { "enabled": true }
}
